+        defects.save(self.r.dir, "DEF-001", meta, body)
+        r = self.sdlc("defect", "impact", "DEF-001", "--write")
+        self.assertEqual(r.returncode, 0, r.stderr)
+        meta, _ = defects.load(self.r.dir, "DEF-001")
